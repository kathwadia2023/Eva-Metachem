# URL of the serverless inquiry endpoint (e.g. a Cloudflare Worker).
# The frontend never contacts an email provider directly, and no
# credentials are ever stored in this repo or in the built site.
VITE_INQUIRY_API_URL=https://your-worker-subdomain.workers.dev/api/inquiry

# Optional: base path when deploying to https://<user>.github.io/<repo>/
# Leave unset (or "/") when using a custom domain at the root.
VITE_BASE_PATH=/
